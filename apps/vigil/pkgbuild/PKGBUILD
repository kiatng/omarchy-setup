pkgname=vigil
pkgver=0.1.0
pkgrel=2
pkgdesc='Keep local work running with adaptive battery protection'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'libnotify' 'systemd')
makedepends=('gcc' 'make')
source=()
sha256sums=()
build() { cd "$startdir/.."; ./bin/build; }
package() {
 cd "$startdir/.."
 install -Dm755 build/vigil "$pkgdir/usr/bin/vigil"
 install -Dm644 LICENSE "$pkgdir/usr/share/licenses/vigil/LICENSE"
 install -Dm644 pkgbuild/vigil.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vigil.svg"
 install -Dm644 pkgbuild/vigil.desktop "$pkgdir/usr/share/applications/vigil.desktop"
 install -Dm644 integration/vigil.service "$pkgdir/usr/lib/systemd/user/vigil.service"
}
